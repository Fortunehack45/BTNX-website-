{
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-btnx-key" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/index.html"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/sse",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/index.html"
    }
  ]
}

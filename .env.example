# BTNX Platform — Environment Configuration Template
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env and provide your production/staging values.

# -----------------------------------------------------------------------------
# 1. Firebase Client & Admin Configuration
# -----------------------------------------------------------------------------
# Active Firestore Database ID (e.g. ai-studio-klamby-efc211be-fa31-444f-8359-2e516e0d2638)
VITE_FIRESTORE_DATABASE_ID=ai-studio-klamby-efc211be-fa31-444f-8359-2e516e0d2638
FIREBASE_DATABASE_ID=ai-studio-klamby-efc211be-fa31-444f-8359-2e516e0d2638

# Firebase Web App Config (Publicly safe client credentials)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=expenses-ai-vfx7o.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=expenses-ai-vfx7o
VITE_FIREBASE_STORAGE_BUCKET=expenses-ai-vfx7o.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=768021477341
VITE_FIREBASE_APP_ID=1:768021477341:web:c578b15abce461d0fae834

# Firebase Server / Admin Credentials (Server-only, DO NOT expose to browser)
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# 2. Server & Security Secrets
# -----------------------------------------------------------------------------
# Secret used for signing short-lived render tokens and HMAC validations
SESSION_SECRET=generate_a_secure_64_char_random_hex_string_here
PORT=4000
NODE_ENV=production

# Privileged Administrative API Key (Server-to-server operations only; no default fallback)
MCP_ADMIN_API_KEY=generate_a_secure_admin_api_key_here

# -----------------------------------------------------------------------------
# 3. OAuth 2.1 Configuration
# -----------------------------------------------------------------------------
# Registered OAuth 2.1 Clients (comma-separated Client IDs)
OAUTH_ALLOWED_CLIENTS=chatgpt,claude,cursor
# Registered Redirect URIs (comma-separated exact matching URLs)
OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/aip/plugin-oauth/callback,https://chat.openai.com/aip/plugin-oauth/callback,https://claude.ai/api/auth/callback

# -----------------------------------------------------------------------------
# 4. Meta WhatsApp Cloud API
# -----------------------------------------------------------------------------
# Webhook verification token configured in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=your_secure_whatsapp_webhook_verify_token
# Meta App Secret used for X-Hub-Signature-256 HMAC-SHA256 validation
META_APP_SECRET=your_meta_app_secret_from_developer_portal
# WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Permanent System User Access Token for sending WhatsApp notifications
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token

# -----------------------------------------------------------------------------
# 5. Google Gemini AI API (Customer Support Assistant)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here

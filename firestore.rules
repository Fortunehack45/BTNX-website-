rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isUser(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidProduct(data) {
      return data.name is string &&
             data.description is string &&
             data.price is number &&
             data.image is string &&
             data.category is string;
    }

    match /users/{userId} {
      allow read, write: if isUser(userId) || isAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cartCount']))
        || isAdmin()
      );
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isUser(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /promoCodes/{promoCodeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /socials/{socialId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /newsletters/{newsletterId} {
      allow read: if isAdmin();
      allow create: if true;
    }
    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

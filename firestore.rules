rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (Auth UID)
    // Fields:
    //   - id: string (optional, immutable, must equal userId)
    //   - uid: string (optional, immutable, must equal userId)
    //   - email: string (optional, size <= 254)
    //   - role: string (optional, 'customer' | 'admin' | 'support')
    //   - name: string (optional, size <= 120)
    //   - displayName: string (optional, size <= 120)
    //   - photoURL: string (optional, size <= 2000)
    //   - avatar: string (optional, size <= 2000)
    //   - createdAt: string | timestamp (optional, immutable)
    //   - updatedAt: string | timestamp (optional)
    //   - phone: string (optional, size <= 40)
    //   - birthday: string (optional, size <= 32)
    //   - address: string (optional, size <= 500)
    //   - shippingStreet: string (optional, size <= 250)
    //   - shippingCity: string (optional, size <= 120)
    //   - shippingState: string (optional, size <= 120)
    //   - shippingZip: string (optional, size <= 32)
    //   - shippingCountry: string (optional, size <= 120)
    //   - whatsappPhone: string (optional, size <= 40)
    //   - connectedMcp: bool (optional)
    //   - mcpClients: list of strings (optional, size <= 20)
    //   - lastMcpActiveAt: string | timestamp (optional)
    //   - mcpToken: string (optional, size <= 256)
    //
    // Collection: products
    // Document ID: productId
    // Fields:
    //   - id: string (optional, size <= 128)
    //   - name: string (required, size 1..200)
    //   - category: string (required, size 1..100)
    //   - price: number (required, >= 0)
    //   - originalPrice: number (optional, >= 0)
    //   - image: string (required, size 1..2000)
    //   - images: list of string (optional, size <= 20)
    //   - badge: string (optional, size <= 80)
    //   - description: string (optional, size <= 5000)
    //   - sizes: list of string (optional, size <= 20)
    //   - colors: list of string (optional, size <= 20)
    //   - collectionId: string (optional, size <= 128)
    //   - stock: number (optional, >= 0)
    //   - cartCount: number (optional)
    //   - fabricAndCare: string (optional, size <= 5000)
    //   - fitDetails: string (optional, size <= 1000)
    //   - deliveryTimeline: string (optional, size <= 120)
    //   - packagingType: string (optional, size <= 120)
    //   - returnPolicy: string (optional, size <= 120)
    //   - shippingFee: number (optional, >= 0)
    //   - isFreeShipping: bool (optional)
    //   - isPinnedHero: bool (optional)
    //   - heroOrder: number (optional, >= 0)
    //   - heroHeadline: string (optional, size <= 200)
    //   - heroSubheadline: string (optional, size <= 200)
    //   - heroLookNumber: string (optional, size <= 60)
    //   - heroImage: string (optional, size <= 2000)
    //
    // Collection: orders
    // Document ID: orderId
    // Fields:
    //   - id: string (required, must equal orderId)
    //   - userId: string (required, size 1..128)
    //   - items: list (required, size 1..100)
    //   - total: number (required, >= 0)
    //   - status: string (required, enum)
    //   - customerEmail, userEmail, email, customerPhone, phone, customerName: optional strings
    //   - shippingStreet, shippingCity, shippingZip, shippingCountry, shippingAddress: optional strings
    //   - subtotal, discountAmount, shippingFee: optional numbers
    //   - date, promoCodeId, source: optional strings
    //   - createdAt: optional string | timestamp
    //
    // Collection: supportTickets
    // Document ID: ticketId
    // Fields:
    //   - id, userId, userEmail, userName, subject, topic, status, mode, messages, createdAt, updatedAt
    //   - orderId, assignedAgent, unreadByAdmin, unreadByCustomer, rating, feedbackComment, feedbackSubmittedAt
    //
    // ===============================================================

    // ------------------------------------------------------------------------
    // Core Authentication & Role Helpers
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return (
        isSignedIn() && (
          (request.auth.token.admin == true) ||
          (
            request.auth.token.email != null &&
            request.auth.token.email.lower() == 'fortunedomination@gmail.com' &&
            request.auth.token.email_verified == true
          ) ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        )
      );
    }

    function isSupport() {
      return (
        isSignedIn() && (
          isAdmin() ||
          (request.auth.token.support == true) ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'support'
          )
        )
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ------------------------------------------------------------------------
    // Schema Validation Helpers
    // ------------------------------------------------------------------------
    function isValidUser(data, userId) {
      return data.keys().hasOnly([
          'id', 'uid', 'email', 'role', 'name', 'displayName', 'photoURL', 'avatar',
          'createdAt', 'updatedAt', 'phone', 'birthday', 'address',
          'shippingStreet', 'shippingCity', 'shippingState', 'shippingZip', 'shippingCountry',
          'whatsappPhone', 'connectedMcp', 'mcpClients', 'lastMcpActiveAt', 'mcpToken'
        ]) &&
        (!('id' in data) || (data.id is string && data.id == userId)) &&
        (!('uid' in data) || (data.uid is string && data.uid == userId)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('role' in data) || (data.role is string && data.role in ['customer', 'admin', 'support'])) &&
        (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 120)) &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2000)) &&
        (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() <= 2000)) &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 40)) &&
        (!('birthday' in data) || data.birthday == null || (data.birthday is string && data.birthday.size() <= 32)) &&
        (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 500)) &&
        (!('shippingStreet' in data) || data.shippingStreet == null || (data.shippingStreet is string && data.shippingStreet.size() <= 250)) &&
        (!('shippingCity' in data) || data.shippingCity == null || (data.shippingCity is string && data.shippingCity.size() <= 120)) &&
        (!('shippingState' in data) || data.shippingState == null || (data.shippingState is string && data.shippingState.size() <= 120)) &&
        (!('shippingZip' in data) || data.shippingZip == null || (data.shippingZip is string && data.shippingZip.size() <= 32)) &&
        (!('shippingCountry' in data) || data.shippingCountry == null || (data.shippingCountry is string && data.shippingCountry.size() <= 120)) &&
        (!('whatsappPhone' in data) || data.whatsappPhone == null || (data.whatsappPhone is string && data.whatsappPhone.size() <= 40)) &&
        (!('connectedMcp' in data) || data.connectedMcp == null || data.connectedMcp is bool) &&
        (!('mcpClients' in data) || data.mcpClients == null || (data.mcpClients is list && data.mcpClients.size() <= 20 && (data.mcpClients.size() == 0 || data.mcpClients[0] is string))) &&
        (!('lastMcpActiveAt' in data) || data.lastMcpActiveAt == null || data.lastMcpActiveAt is timestamp || (data.lastMcpActiveAt is string && data.lastMcpActiveAt.size() <= 64)) &&
        (!('mcpToken' in data) || data.mcpToken == null || (data.mcpToken is string && data.mcpToken.size() <= 256));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'category', 'price', 'image']) &&
        data.keys().hasOnly([
          'id', 'name', 'category', 'price', 'originalPrice', 'image', 'images',
          'badge', 'description', 'sizes', 'colors', 'collectionId', 'stock', 'cartCount',
          'fabricAndCare', 'fitDetails', 'deliveryTimeline', 'packagingType', 'returnPolicy',
          'shippingFee', 'isFreeShipping', 'isPinnedHero', 'heroOrder', 'heroHeadline',
          'heroSubheadline', 'heroLookNumber', 'heroImage'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.price is number && data.price >= 0 &&
        data.image is string && data.image.size() >= 1 && data.image.size() <= 2000 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('originalPrice' in data) || data.originalPrice == null || (data.originalPrice is number && data.originalPrice >= 0)) &&
        (!('badge' in data) || data.badge == null || (data.badge is string && data.badge.size() <= 80)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        (!('sizes' in data) || (data.sizes is list && data.sizes.size() <= 20 && (data.sizes.size() == 0 || data.sizes[0] is string))) &&
        (!('colors' in data) || (data.colors is list && data.colors.size() <= 20 && (data.colors.size() == 0 || data.colors[0] is string))) &&
        (!('images' in data) || (data.images is list && data.images.size() <= 20 && (data.images.size() == 0 || data.images[0] is string))) &&
        (!('collectionId' in data) || (data.collectionId is string && data.collectionId.size() <= 128)) &&
        (!('stock' in data) || (data.stock is number && data.stock >= 0)) &&
        (!('cartCount' in data) || data.cartCount is number) &&
        (!('fabricAndCare' in data) || data.fabricAndCare == null || (data.fabricAndCare is string && data.fabricAndCare.size() <= 5000)) &&
        (!('fitDetails' in data) || data.fitDetails == null || (data.fitDetails is string && data.fitDetails.size() <= 1000)) &&
        (!('deliveryTimeline' in data) || data.deliveryTimeline == null || (data.deliveryTimeline is string && data.deliveryTimeline.size() <= 120)) &&
        (!('packagingType' in data) || data.packagingType == null || (data.packagingType is string && data.packagingType.size() <= 120)) &&
        (!('returnPolicy' in data) || data.returnPolicy == null || (data.returnPolicy is string && data.returnPolicy.size() <= 120)) &&
        (!('shippingFee' in data) || data.shippingFee == null || (data.shippingFee is number && data.shippingFee >= 0)) &&
        (!('isFreeShipping' in data) || data.isFreeShipping == null || data.isFreeShipping is bool) &&
        (!('isPinnedHero' in data) || data.isPinnedHero == null || data.isPinnedHero is bool) &&
        (!('heroOrder' in data) || data.heroOrder == null || (data.heroOrder is number && data.heroOrder >= 0)) &&
        (!('heroHeadline' in data) || data.heroHeadline == null || (data.heroHeadline is string && data.heroHeadline.size() <= 200)) &&
        (!('heroSubheadline' in data) || data.heroSubheadline == null || (data.heroSubheadline is string && data.heroSubheadline.size() <= 200)) &&
        (!('heroLookNumber' in data) || data.heroLookNumber == null || (data.heroLookNumber is string && data.heroLookNumber.size() <= 60)) &&
        (!('heroImage' in data) || data.heroImage == null || (data.heroImage is string && data.heroImage.size() <= 2000));
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll(['id', 'userId', 'items', 'total', 'status']) &&
        data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'customerEmail', 'email',
          'phone', 'customerPhone', 'customerName',
          'shippingStreet', 'shippingCity', 'shippingZip', 'shippingCountry',
          'items', 'total', 'status', 'date', 'promoCodeId', 'createdAt',
          'source', 'shippingAddress', 'subtotal', 'discountAmount', 'shippingFee'
        ]) &&
        data.id is string && data.id == orderId &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        (!('userEmail' in data) || data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 254)) &&
        (!('customerEmail' in data) || data.customerEmail == null || (data.customerEmail is string && data.customerEmail.size() <= 254)) &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 40)) &&
        (!('customerPhone' in data) || data.customerPhone == null || (data.customerPhone is string && data.customerPhone.size() <= 40)) &&
        (!('customerName' in data) || data.customerName == null || (data.customerName is string && data.customerName.size() <= 120)) &&
        (!('shippingStreet' in data) || data.shippingStreet == null || (data.shippingStreet is string && data.shippingStreet.size() <= 250)) &&
        (!('shippingCity' in data) || data.shippingCity == null || (data.shippingCity is string && data.shippingCity.size() <= 120)) &&
        (!('shippingZip' in data) || data.shippingZip == null || (data.shippingZip is string && data.shippingZip.size() <= 32)) &&
        (!('shippingCountry' in data) || data.shippingCountry == null || (data.shippingCountry is string && data.shippingCountry.size() <= 120)) &&
        (!('source' in data) || data.source == null || (data.source is string && data.source.size() <= 64)) &&
        (!('shippingAddress' in data) || data.shippingAddress == null || (data.shippingAddress is string && data.shippingAddress.size() <= 500)) &&
        (!('subtotal' in data) || data.subtotal == null || (data.subtotal is number && data.subtotal >= 0)) &&
        (!('discountAmount' in data) || data.discountAmount == null || (data.discountAmount is number && data.discountAmount >= 0)) &&
        (!('shippingFee' in data) || data.shippingFee == null || (data.shippingFee is number && data.shippingFee >= 0)) &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 &&
        data.total is number && data.total >= 0 &&
        data.status is string && data.status in [
          'Pending', 'Confirmed', 'Processing', 'Shipped', 'In Transit', 'Delivered', 'Cancelled',
          'pending', 'confirmed', 'shipped', 'delivered', 'cancelled'
        ] &&
        (!('date' in data) || data.date == null || (data.date is string && data.date.size() <= 64)) &&
        (!('promoCodeId' in data) || data.promoCodeId == null || (data.promoCodeId is string && data.promoCodeId.size() <= 64)) &&
        (!('createdAt' in data) || data.createdAt == null || data.createdAt is string || data.createdAt is timestamp);
    }

    function isValidPromoCode(data) {
      return data.keys().hasAll(['code']) &&
        data.keys().hasOnly(['id', 'code', 'discountPercentage', 'percentage', 'expiresAt', 'createdAt', 'isActive', 'collectionId']) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 64 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('discountPercentage' in data) || (data.discountPercentage is number && data.discountPercentage >= 1 && data.discountPercentage <= 100)) &&
        (!('percentage' in data) || (data.percentage is number && data.percentage >= 1 && data.percentage <= 100)) &&
        (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('collectionId' in data) || (data.collectionId is string && data.collectionId.size() <= 128));
    }

    function isValidCollection(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.keys().hasOnly(['id', 'name', 'promoCodeId']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('promoCodeId' in data) || (data.promoCodeId is string && data.promoCodeId.size() <= 128));
    }

    function isValidSocial(data) {
      return data.keys().hasAll(['id', 'platform', 'url']) &&
        data.keys().hasOnly(['id', 'platform', 'url']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 64 &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 500;
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'createdAt', 'subscribedAt']) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('subscribedAt' in data) || (data.subscribedAt is string && data.subscribedAt.size() <= 64));
    }

    function isValidSiteContent(data) {
      return data.keys().hasOnly(['announcements']) &&
        (!('announcements' in data) || (data.announcements is list && data.announcements.size() <= 50 && (data.announcements.size() == 0 || data.announcements[0] is string)));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'message', 'type', 'createdAt', 'readBy', 'isRead']) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        data.type is string && data.type in ['order_status', 'promo', 'new_arrival', 'system'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('isRead' in data) || data.isRead is bool) &&
        (!('readBy' in data) || (data.readBy is list && data.readBy.size() <= 5000 && (data.readBy.size() == 0 || data.readBy[0] is string)));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt']) &&
        data.keys().hasOnly(['id', 'productId', 'userId', 'userName', 'userEmail', 'rating', 'comment', 'createdAt', 'avatar']) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 254)) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 2000 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500));
    }

    function isValidSupportTicket(data, ticketId) {
      return data.keys().hasAll([
          'id', 'userId', 'userEmail', 'userName', 'subject', 'topic', 'status', 'mode', 'messages', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'userName', 'subject', 'topic', 'orderId', 'status', 'mode',
          'assignedAgent', 'messages', 'createdAt', 'updatedAt', 'unreadByAdmin', 'unreadByCustomer',
          'rating', 'feedbackComment', 'feedbackSubmittedAt'
        ]) &&
        data.id is string && data.id == ticketId &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120 &&
        (!('orderId' in data) || data.orderId == null || (data.orderId is string && data.orderId.size() <= 128)) &&
        data.status is string && data.status in ['open', 'escalated', 'resolved', 'pending_human', 'human_active'] &&
        data.mode is string && data.mode in ['bot', 'human'] &&
        (!('assignedAgent' in data) || data.assignedAgent == null || (data.assignedAgent is string && data.assignedAgent.size() <= 120)) &&
        data.messages is list && data.messages.size() >= 1 && data.messages.size() <= 250 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('unreadByAdmin' in data) || data.unreadByAdmin is bool) &&
        (!('unreadByCustomer' in data) || data.unreadByCustomer is bool) &&
        (!('rating' in data) || data.rating == null || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
        (!('feedbackComment' in data) || data.feedbackComment == null || (data.feedbackComment is string && data.feedbackComment.size() <= 500)) &&
        (!('feedbackSubmittedAt' in data) || data.feedbackSubmittedAt == null || (data.feedbackSubmittedAt is string && data.feedbackSubmittedAt.size() <= 64));
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    // 1. Users: Customers can read and update their own document only. Role elevation is strictly forbidden.
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin() || isSupport());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUser(incoming(), userId) && (
        isAdmin() || (
          isOwner(userId) &&
          (!('role' in incoming()) || incoming().role == 'customer') &&
          (!('id' in incoming()) || incoming().id == userId) &&
          (!('uid' in incoming()) || incoming().uid == userId)
        )
      );
      allow update: if isValidId(userId) && isValidUser(incoming(), userId) && (
        isAdmin() || (
          isOwner(userId) &&
          (
            !('role' in incoming()) ||
            ('role' in existing() && incoming().role == existing().role) ||
            (!('role' in existing()) && incoming().role == 'customer')
          ) &&
          (!('id' in incoming()) || incoming().id == userId) &&
          (!('id' in existing()) || !('id' in incoming()) || incoming().id == existing().id) &&
          (!('uid' in incoming()) || incoming().uid == userId) &&
          (!('uid' in existing()) || !('uid' in incoming()) || incoming().uid == existing().uid) &&
          (!('email' in incoming()) || !('email' in existing()) || incoming().email == existing().email) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'uid', 'email', 'name', 'displayName', 'photoURL', 'avatar',
            'phone', 'birthday', 'address',
            'shippingStreet', 'shippingCity', 'shippingState', 'shippingZip', 'shippingCountry',
            'whatsappPhone', 'connectedMcp', 'mcpClients', 'lastMcpActiveAt', 'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Orders: Direct lookup allowed by valid ID for tracking and MCP widgets; list allowed for admin, support, owner, or queries with limit <= 50; create allowed for owner, admin, or trusted sources.
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if (
        isAdmin() ||
        isSupport() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (request.query.limit <= 50)
      );
      allow create: if isValidId(orderId) && isValidOrder(incoming(), orderId) && (
        isAdmin() ||
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        (incoming().source in ['mcp-agent', 'mcp-server', 'remote-mcp', 'storefront', 'btnx-storefront', 'checkout'])
      );
      allow update: if isValidId(orderId) && (isAdmin() || isSupport()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status is string &&
        incoming().status in [
          'Pending', 'Confirmed', 'Processing', 'Shipped', 'In Transit', 'Delivered', 'Cancelled',
          'pending', 'confirmed', 'shipped', 'delivered', 'cancelled'
        ];
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 3. Products: Public read for storefront; Admin-only write.
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isValidProduct(incoming()) && (
        isAdmin() || (
          isSignedIn() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['cartCount']) &&
          incoming().cartCount is number
        )
      );
      allow delete: if isValidId(productId) && isAdmin();
    }

    // 4. Support Tickets: Strict customer isolation. Customers can only read and list their own tickets.
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (
        (resource.data.userId == request.auth.uid) || isAdmin() || isSupport()
      );
      allow list: if isSignedIn() && (
        (resource.data.userId == request.auth.uid) || isAdmin() || isSupport()
      );
      allow create: if isValidId(ticketId) && isSignedIn() &&
        isValidSupportTicket(incoming(), ticketId) &&
        incoming().userId == request.auth.uid;
      allow update: if isValidId(ticketId) && isSignedIn() && (
        (
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'messages', 'unreadByAdmin', 'rating', 'feedbackComment', 'feedbackSubmittedAt', 'updatedAt'
          ])
        ) ||
        isAdmin() ||
        isSupport()
      );
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    // 5. Notifications: User-scoped or broadcast.
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        existing().userId == request.auth.uid || existing().userId == 'broadcast' || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid || existing().userId == 'broadcast' || isAdmin()
      );
      allow create: if isValidId(notificationId) && (
        isAdmin() ||
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        isValidNotification(incoming())
      );
      allow update: if isValidId(notificationId) && isSignedIn() && isValidNotification(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        (existing().userId == 'broadcast' && incoming().diff(existing()).affectedKeys().hasOnly(['readBy']))
      );
      allow delete: if isValidId(notificationId) && isAdmin();
    }

    // 6. Reviews: Public read; Authenticated verified review submission.
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) && isSignedIn() && isValidReview(incoming()) &&
        incoming().userId == request.auth.uid &&
        reviewId == incoming().productId + '_' + request.auth.uid;
      allow update: if isValidId(reviewId) && isSignedIn() && isValidReview(incoming()) && (
        (existing().userId == request.auth.uid && incoming().userId == request.auth.uid) || isAdmin()
      );
      allow delete: if isValidId(reviewId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 7. Store Settings, Promos, Collections, Socials, Content: Public read, Admin write.
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promoCodes/{promoCodeId} {
      allow get: if isValidId(promoCodeId);
      allow list: if true;
      allow create, update, delete: if isValidId(promoCodeId) && isAdmin() && isValidPromoCode(incoming());
    }

    match /collections/{collectionId} {
      allow get: if isValidId(collectionId);
      allow list: if true;
      allow create, update, delete: if isValidId(collectionId) && isAdmin() && isValidCollection(incoming());
    }

    match /socials/{socialId} {
      allow get: if isValidId(socialId);
      allow list: if true;
      allow create, update, delete: if isValidId(socialId) && isAdmin() && isValidSocial(incoming());
    }

    match /newsletters/{newsletterId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(newsletterId) && isValidNewsletter(incoming());
      allow update, delete: if isValidId(newsletterId) && isAdmin();
    }

    match /siteContent/{contentId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(contentId) && isAdmin() && isValidSiteContent(incoming());
    }

    // ------------------------------------------------------------------------
    // Protected Credentials & System Collections (Client Access Strictly Denied)
    // Managed exclusively through trusted backend services via Admin SDK
    // ------------------------------------------------------------------------
    // Personal Access Tokens: Scoped token access for authenticated users and admins
    match /personal_access_tokens/{tokenId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().uid == request.auth.uid && incoming().tokenHash is string && incoming().id == tokenId;
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /oauth_tokens/{tokenHash} {
      allow read, write: if false;
    }
    match /oauth_codes/{codeHash} {
      allow read, write: if false;
    }
    match /whatsapp_identities/{phoneId} {
      allow read, write: if false;
    }
    match /auth_challenges/{challengeId} {
      allow read, write: if false;
    }
    match /sessions/{sessionId} {
      allow read, write: if false;
    }
    match /mcpTokens/{token} {
      allow read, write: if false;
    }
    match /whatsappUsers/{phone} {
      allow read, write: if false;
    }
  }
}

{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon-.*\\.png|apple-touch-icon\\.png|og-preview\\.jpg|btnx-og-preview\\.jpg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|site\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/product/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/product/:path*"
    },
    {
      "source": "/p/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/p/:path*"
    },
    {
      "source": "/share/product/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/share/product/:path*"
    },
    {
      "source": "/share/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/share/:path*"
    },
    {
      "source": "/og/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/og/:path*"
    },
    {
      "source": "/api/user/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/api/user/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://btnx-website-mcp.vercel.app/api/health"
    },
    {
      "source": "/api/oauth/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/oauth/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/oauth/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/.well-known/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://btnx-website-mcp.vercel.app/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/mcp/:path*"
    },
    {
      "source": "/render/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/render/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://btnx-website-mcp.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^admin\\..*"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^support\\..*"
        }
      ],
      "destination": "/support/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/support-staff",
      "destination": "/support/index.html"
    },
    {
      "source": "/support-staff/:path*",
      "destination": "/support/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

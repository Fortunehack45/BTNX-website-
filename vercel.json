{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon-.*\\.png|apple-touch-icon\\.png|og-preview\\.jpg|btnx-og-preview\\.jpg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|site\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/product/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/product/$1"
    },
    {
      "source": "/p/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/p/$1"
    },
    {
      "source": "/share/product/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/share/product/$1"
    },
    {
      "source": "/share/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/share/$1"
    },
    {
      "source": "/og/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/og/$1"
    },
    {
      "source": "/api/user/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/api/user/$1"
    },
    {
      "source": "/api/health",
      "destination": "https://btnx-website-mcp.vercel.app/api/health"
    },
    {
      "source": "/api/oauth/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/oauth/$1"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/oauth/$1"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/.well-known/$1"
    },
    {
      "source": "/mcp",
      "destination": "https://btnx-website-mcp.vercel.app/mcp"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/mcp/$1"
    },
    {
      "source": "/render/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/render/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://btnx-website-mcp.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^admin\\..*"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^support\\..*"
        }
      ],
      "destination": "/support/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/support-staff",
      "destination": "/support/index.html"
    },
    {
      "source": "/support-staff/(.*)",
      "destination": "/support/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An e-commerce product in the BTNX catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "image": { "type": "string", "maxLength": 2000 },
        "images": { "type": "array" },
        "badge": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 5000 },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "collectionId": { "type": "string", "maxLength": 128 },
        "stock": { "type": "number" },
        "cartCount": { "type": "number" }
      },
      "required": ["name", "category", "price", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 254 },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": {
          "type": "string",
          "enum": [
            "Pending",
            "Confirmed",
            "Processing",
            "Shipped",
            "In Transit",
            "Delivered",
            "Cancelled",
            "pending",
            "confirmed",
            "shipped",
            "delivered",
            "cancelled"
          ]
        },
        "date": { "type": "string", "maxLength": 64 },
        "promoCodeId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "items", "total", "status"]
    },
    "User": {
      "title": "User",
      "description": "A registered user of the platform",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "name": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "phone": { "type": "string", "maxLength": 40 },
        "birthday": { "type": "string", "maxLength": 32 },
        "shippingStreet": { "type": "string", "maxLength": 250 },
        "shippingCity": { "type": "string", "maxLength": 120 },
        "shippingZip": { "type": "string", "maxLength": 32 },
        "shippingCountry": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "email", "role"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "A promotional discount voucher",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "discountPercentage": { "type": "number" },
        "percentage": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" },
        "collectionId": { "type": "string", "maxLength": 128 }
      },
      "required": ["code"]
    },
    "Collection": {
      "title": "Collection",
      "description": "A curated collection of garments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "promoCodeId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name"]
    },
    "Social": {
      "title": "Social",
      "description": "A brand social media link",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "platform": { "type": "string", "maxLength": 64 },
        "url": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "platform", "url"]
    },
    "Newsletter": {
      "title": "Newsletter",
      "description": "A newsletter dispatch subscription",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Storefront rotating announcements and hero content",
      "type": "object",
      "properties": {
        "announcements": { "type": "array" }
      },
      "required": ["announcements"]
    },
    "Notification": {
      "title": "Notification",
      "description": "An account alert or broadcast notification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["order_status", "promo", "new_arrival", "system"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array" },
        "isRead": { "type": "boolean" }
      },
      "required": ["userId", "title", "message", "type", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer product review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userEmail": { "type": "string", "maxLength": 254 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "avatar": { "type": "string", "maxLength": 500 }
      },
      "required": ["productId", "userId", "userName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": { "schema": "Product", "description": "Products collection" },
    "/orders/{orderId}": { "schema": "Order", "description": "Orders collection" },
    "/users/{userId}": { "schema": "User", "description": "Users collection" },
    "/promoCodes/{promoCodeId}": { "schema": "PromoCode", "description": "Promo codes collection" },
    "/collections/{collectionId}": { "schema": "Collection", "description": "Collections collection" },
    "/socials/{socialId}": { "schema": "Social", "description": "Socials collection" },
    "/newsletters/{newsletterId}": { "schema": "Newsletter", "description": "Newsletter subscribers" },
    "/siteContent/{contentId}": { "schema": "SiteContent", "description": "Storefront announcement banners" },
    "/notifications/{notificationId}": { "schema": "Notification", "description": "Notifications collection" },
    "/reviews/{reviewId}": { "schema": "Review", "description": "Product reviews collection" }
  }
}
